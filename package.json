{
  "name": "akkod",
  "productName": "akkod",
  "version": "1.0.0",
  "description": "Configuration tool for the Akko 5075S (QMK/VIA): keymap, knob, lighting.",
  "main": "src/main/main.js",
  "author": {
    "name": "WeeXnes",
    "email": "weexnes@weexnes.dev"
  },
  "license": "GPL-3.0-or-later",
  "type": "commonjs",
  "scripts": {
    "dev": "vite",
    "electron:dev": "VITE_DEV_SERVER_URL=http://localhost:5173 bash ./scripts/run-electron.sh",
    "build": "vite build",
    "start": "bash ./scripts/run-electron.sh",
    "test": "node test/verify.mjs",
    "probe": "node test/probe-hw.mjs",
    "dist:linux": "vite build && electron-builder --linux",
    "dist:win": "bash installer/build.sh",
    "install:desktop": "node scripts/install-desktop.mjs",
    "uninstall:desktop": "node scripts/install-desktop.mjs --uninstall",
    "dist:win-zip": "vite build && electron-builder --win zip"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "vue": "^3.5.45"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.10",
    "electron": "^45.3.3",
    "electron-builder": "^26.18.0",
    "vite": "^8.3.6"
  },
  "build": {
    "appId": "dev.weexnes.akkod",
    "productName": "akkod",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "src/main/**",
      "src/preload/**",
      "assets/akkod.png",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "scripts/70-akko-5075s-via.rules",
        "to": "70-akko-5075s-via.rules"
      }
    ],
    "linux": {
      "target": [
        "AppImage",
        "pacman",
        "deb"
      ],
      "category": "Settings",
      "icon": "assets/icons",
      "executableName": "akkod",
      "synopsis": "Akko 5075S keyboard configuration",
      "desktop": {
        "entry": {
          "StartupWMClass": "akkod",
          "Keywords": "akko;keyboard;qmk;via;rgb;keymap;"
        }
      },
      "maintainer": "WeeXnes <weexnes@weexnes.dev>"
    },
    "pacman": {
      "afterInstall": "scripts/linux-after-install.sh",
      "afterRemove": "scripts/linux-after-remove.sh"
    },
    "deb": {
      "afterInstall": "scripts/linux-after-install.sh",
      "afterRemove": "scripts/linux-after-remove.sh"
    },
    "win": {
      "target": [
        "zip"
      ],
      "icon": "assets/akkod.ico",
      "signAndEditExecutable": true
    }
  },
  "homepage": "https://code.weexnes.dev"
}
